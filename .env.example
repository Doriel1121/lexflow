# PostgreSQL (local docker db only)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lexflowdb

# App DB connection (single source of truth)
# Local docker:
# DATABASE_URL=postgresql+asyncpg://admin:change-me@db:5432/lexflowdb
# Render:
# DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>/<db>
DATABASE_URL=postgresql+asyncpg://admin:change-me@db:5432/lexflowdb

# Security
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Configuration
AI_PROVIDER=cohere
# Optional task-specific routing. Leave empty to use AI_PROVIDER for all tasks.
AI_READER_PROVIDER=
AI_DRAFTING_PROVIDER=
AI_EMBEDDING_PROVIDER=
AI_FALLBACK_PROVIDER=
# Optional: estimated AI provider pricing in USD per 1M tokens. Keep current prices here.
# Use exact model names or "*" wildcard per provider. Missing prices show as unconfigured/0 cost.
AI_COST_PRICING_JSON={"gemini":{"*":{"input_per_1m":0,"output_per_1m":0}},"cohere":{"*":{"input_per_1m":0,"output_per_1m":0}},"openrouter":{"*":{"input_per_1m":0,"output_per_1m":0}},"ollama":{"*":{"input_per_1m":0,"output_per_1m":0}}}
COHERE_API_KEY=your_cohere_api_key_here
COHERE_BASE_URL=https://api.cohere.com
COHERE_COMPAT_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-r-03-2025
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIM=768
COHERE_TIMEOUT_SECONDS=120

# Runtime / process mode
# api    = FastAPI only
# worker = Celery only
# all    = FastAPI + Celery via supervisord, useful for constrained staging/demo
# migrate = run migrations/seed and exit
LEXFLOW_PROCESS_MODE=api
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SEED_ON_STARTUP=true
UVICORN_WORKERS=1
UVICORN_RELOAD=false
CELERY_CONCURRENCY=4
CELERY_POOL=threads
CELERY_QUEUES=default,documents,ai,celery

# Processing Mode
# Production should use celery so heavy document processing does not run inside API workers.
DOCUMENT_PROCESSING_MODE=celery
AI_TAG_MIN_CONFIDENCE=0.55
AI_TAG_MAX_PER_DOCUMENT=8

# Feature Flags
LEGAL_WORKFLOWS_ENABLED=false
VITE_LEGAL_WORKFLOWS_ENABLED=false

# Reaper Configuration
DOCUMENT_STUCK_MINUTES=30

# Storage Backend: "b2" | "r2" | "s3" | "local"
# Current (MVP): b2
# AWS migration: change to s3 and fill S3_* vars
STORAGE_BACKEND=b2

# AWS S3 (fill when migrating to AWS)
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=lexflow-files
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=<aws-access-key>
# S3_SECRET_ACCESS_KEY=<aws-secret-key>

# Seed Data (auto-seeded on first deploy)
SEED_ORG_NAME=LexFlow
SEED_ORG_SLUG=lexflow
SEED_ADMIN_EMAIL=admin@lexflow.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ORG_ADMIN_EMAIL=orgadmin@lexflow.com
SEED_ORG_ADMIN_PASSWORD=change-me-strong-password

# Environment
ENVIRONMENT=development
APP_ENV=development

# Gemini AI provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# AI policy routing overrides
AI_LEGAL_REASONING_PROVIDER=gemini
AI_LEGAL_DRAFTING_PROVIDER=
AI_LONG_CONTEXT_PROVIDER=gemini
AI_CLASSIFICATION_PROVIDER=
AI_LOW_RISK_PROVIDER=

# API/runtime hardening
API_REQUEST_TIMEOUT_SECONDS=0
METRICS_CELERY_QUEUES=default,documents,ai,celery
ENABLE_TEST_UPLOAD_BYPASS=false
